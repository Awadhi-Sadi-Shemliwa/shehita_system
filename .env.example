# Production secrets for docker-compose.prod.yml
# --------------------------------------------------
# Copy this file to ".env" on the VPS and replace every value below.
# NEVER commit the real .env file to git.
#
# Generate strong random values, e.g. on the VPS:
#   openssl rand -base64 24

# ---- Database -------------------------------------------------------------
# MySQL root password (also used by the app to connect).
#
# NOTE: the app connects as root because provisioning a new client company
# requires CREATE DATABASE. Each company gets its own database (shems_<slug>).
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-string

# The platform's own database: which companies exist, their subscriptions,
# payments and SHEHITA's admin accounts. NOT a client's data.
CONTROL_DB_NAME=shehita_control

# ---- Networking -----------------------------------------------------------
# Which port on the HOST this stack is published at, bound to 127.0.0.1 so only
# Nginx (running on the VPS) can reach it — never the internet directly.
#
# Leave this commented out for production: it defaults to 8080, which is what
# the system.shehita.co.tz vhost already proxies to.
#
# Set it ONLY for a second, parallel deployment — a staging copy of this stack
# on the same VPS. Two stacks cannot share a host port. If you set it, the
# matching Nginx vhost's proxy_pass must use the same number.
#
#   WEB_PORT=8081
#
# (Also change it if port 8080 is already taken by another app on the machine.)
# WEB_PORT=8080

# ---- Application ----------------------------------------------------------
# Public base URL, with no trailing slash. Used to build the links that go out
# in emails, so this MUST be correct or nobody can find their portal.
APP_BASE_URL=https://system.shehita.co.tz
APP_TIMEZONE=Africa/Dar_es_Salaam

# Free trial length for new companies, in days. Snapshotted per company at
# signup, so changing it later never moves an existing customer's window.
TRIAL_DAYS=14

# ---- SHEHITA admin console (/admin) ---------------------------------------
# The first platform administrator, created on first run.
# This is SHEHITA's own login, NOT a client company login.
PLATFORM_ADMIN_EMAIL=admin@shehita.co.tz
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-password

# Who receives the one-click "confirm this payment" emails. Comma-separated.
BILLING_ADMIN_EMAILS=admin@shehita.co.tz

# ---- Email ----------------------------------------------------------------
# The whole subscription flow runs on email, so this must work in production.
#
#   resend  - HTTPS API, needs only RESEND_API_KEY (recommended: no SMTP setup,
#             no mail server in the container)
#   smtp    - PHPMailer over SMTP, needs the SMTP_* values below
#   log     - write emails to the container log instead of sending (dev only)
MAIL_DRIVER=resend
MAIL_FROM="SHEHITA EMS <no-reply@shehita.co.tz>"
RESEND_API_KEY=replace-with-your-resend-api-key

# Only needed when MAIL_DRIVER=smtp
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_SECURE=tls

# ---- Scheduled jobs -------------------------------------------------------
# Protects cron/subscription-notices.php, which is reachable over HTTP.
# Host crontab entry:
#   0 7 * * * curl -fsS -H "X-Cron-Key: <this value>" http://127.0.0.1:8080/cron/subscription-notices.php
CRON_KEY=replace-with-a-long-random-string

# ---- AI assistant ---------------------------------------------------------
# Anthropic API key for the in-app assistant. Leave empty to disable it.
ANTHROPIC_API_KEY=
